# ============================================================
# Uptime SaaS - ortam degiskenleri
# Kullanim: bu dosyayi .env.local olarak kopyalayip doldurun.
# .env.local asla git'e eklenmez.
# ============================================================

# --- Uygulama ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Status page'ler icin ana alan adi (ornek: kullanici.siten.com)
NEXT_PUBLIC_STATUS_BASE_DOMAIN=siten.com

# --- PostgreSQL (SaaS katmani, Prisma) ---
# Secenek 1 (onerilen): Neon (ucretsiz tier)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Neon icin migration'larda kullanilan dogrudan baglanti
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Secenek 2: yerel Docker
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uptime_saas"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/uptime_saas"

# --- Redis (BullMQ, rate limit) ---
# Secenek 1 (onerilen): Upstash (TLS icin rediss://)
REDIS_URL="rediss://default:PASSWORD@HOST:6379"
# Secenek 2: yerel Docker
# REDIS_URL="redis://localhost:6379"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnizca sunucuda kullanilir, istemciye asla verilmez
SUPABASE_SERVICE_ROLE_KEY=

# --- Uptime Kuma (Socket.IO) ---
# Dokploy uzerindeki instance
UPTIME_KUMA_URL=http://185.97.146.46:3001
# Kullanici bazli kimlik bilgileri veritabaninda sifreli tutulur;
# bu anahtar o sifreleme icindir (32 byte, hex). Ornek: openssl rand -hex 32
UPTIME_KUMA_CREDENTIALS_KEY=
# Kullanici olusturmak icin kullanilan yonetici hesabi
UPTIME_KUMA_ADMIN_USERNAME=
UPTIME_KUMA_ADMIN_PASSWORD=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_YEARLY=

# --- E-posta (Resend veya Postmark) ---
RESEND_API_KEY=
EMAIL_FROM="Uptime SaaS <noreply@siten.com>"

# --- Reklam / analitik ---
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Admin paneli ---
# Yalnizca bu e-postaya sahip kullanici /admin'e girebilir
ADMIN_EMAIL=tkoccat@gmail.com
