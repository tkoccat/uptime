# ============================================================
# Uptime SaaS - ortam degiskenleri
# Kullanim: bu dosyayi .env.local (gelistirme) veya Dokploy "Environment" sekmesine (uretim) kopyalayin.
# .env.local asla git'e eklenmez. Sirlari (anahtar, sifre) kimseyle paylasmayin.
# NEXT_PUBLIC_* degerleri derleme sirasinda JS'e gomulur; degisirse imaj yeniden derlenmelidir.
# ============================================================

# --- Uygulama ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Status page'ler icin ana alan adi: <slug>.siten.com seklinde yayinlanir
NEXT_PUBLIC_STATUS_BASE_DOMAIN=siten.com
# Uygulama sayilacak ek host adlari (virgulle): www, ic ag adlari vb. Bunlar disindaki host adlari
# "ozel alan adi" (status page) olarak ele alinir.
APP_HOSTS=www.siten.com

# --- PostgreSQL (SaaS katmani, Prisma) ---
# Secenek 1 (onerilen, yerelde): Neon (ucretsiz tier)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Neon icin migration'larda kullanilan dogrudan baglanti (pooler olmayan adres)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Secenek 2: yerel Docker
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uptime_saas"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/uptime_saas"
# Docker Compose (uretim) icin: yalnizca sifre; baglantilar compose dosyasinda kurulur
POSTGRES_PASSWORD=

# --- Redis (BullMQ kuyrugu, hiz siniri) ---
# Secenek 1 (onerilen, yerelde): Upstash (TLS icin rediss://)
REDIS_URL="rediss://default:PASSWORD@HOST:6379"
# Secenek 2: yerel Docker
# REDIS_URL="redis://localhost:6379"
# (REDIS_URL bos birakilirsa: hiz siniri bellekte, isler ayni surecte calisir; yalnizca gelistirme icin)

# --- Uygulama sifreleme anahtari (bildirim kanali gizli bilgileri, dogrulama baglantilari) ---
# 32 bayt hex:  openssl rand -hex 32   (Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_ENCRYPTION_KEY=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnizca sunucuda kullanilir (hesap silme), istemciye asla verilmez
SUPABASE_SERVICE_ROLE_KEY=

# --- Uptime Kuma (Socket.IO) ---
# Dokploy uzerindeki instance (compose icinden: http://uptime-kuma:3001)
UPTIME_KUMA_URL=http://185.97.146.46:3001
# Kuma ana surumu (imaj louislam/uptime-kuma:2 icin 2)
UPTIME_KUMA_MAJOR=2
# Uptime Kuma tek yonetici hesabi kullanir; SaaS bu servis hesabiyla baglanir
UPTIME_KUMA_ADMIN_USERNAME=
UPTIME_KUMA_ADMIN_PASSWORD=
# Kuma'nin olaylari bize ilettigi webhook'un gizli anahtari (openssl rand -hex 24)
KUMA_WEBHOOK_SECRET=
# Kuma'nin uygulamaya ulasacagi adres (compose icinde http://nextjs-app:3000; bos ise NEXT_PUBLIC_APP_URL)
# KUMA_WEBHOOK_BASE_URL=http://nextjs-app:3000

# --- Caddy on-demand TLS (ozel alan adlari) ---
# Caddy'nin "bu alan icin sertifika uretilsin mi?" sorusunu yanitlayan uc nokta icin gizli anahtar
CADDY_ASK_SECRET=
# Ozel alan adi dogrulamasi: CNAME -> cname.<STATUS_BASE_DOMAIN> veya A kaydi bu IP'ye
STATUS_SERVER_IP=
# Caddy (profil "edge") icin
APP_DOMAIN=app.siten.com
ACME_EMAIL=
# CADDY_UPSTREAM=nextjs-app:3000
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_YEARLY=

# --- E-posta (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Uptime SaaS <noreply@siten.com>"

# --- SMS (Twilio, istege bagli) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Reklam / analitik (yalnizca cerez onayi sonrasi yuklenir) ---
NEXT_PUBLIC_GTAG_ID=
# Google Ads donusum etiketi: AW-XXXXXXXXX/etiket
NEXT_PUBLIC_GTAG_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Yonetim ve yasal ---
# Yalnizca bu e-postaya sahip kullanici(lar) /admin'e girebilir (birden fazla icin virgulle ayirin)
ADMIN_EMAIL=
# Avukat incelemesi bitince true yapin: yasal sayfalardaki taslak uyarisi kalkar
LEGAL_REVIEWED=false
